# Normalize line endings in the repository; check out native on each platform.
* text=auto eol=lf

# Windows-only helpers must keep CRLF if a maintainer needs one.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets: never touched.
*.png binary
*.jpg binary
*.ico binary
*.svg text eol=lf

# Lockfiles are generated; keep them out of diffs' noise where possible.
pnpm-lock.yaml -diff
